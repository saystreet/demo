# Render sets PORT itself; don't set it there
PORT=8080
# Public address of the backend, no trailing slash. Locally http://localhost:8080
APP_URL=

# Local: postgres://saystreet:saystreet@localhost:5432/saystreet (docker compose up -d)
# Render: the Internal Database URL of the Postgres instance
DATABASE_URL=

# 32 random bytes in hex each: openssl rand -hex 32
SESSION_SECRET=
ADMIN_TOKEN=

# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From developer.paypal.com → your app → Webhooks, after the first deploy
PAYPAL_WEBHOOK_ID=
# Vault payment token of the sandbox buyer, from /admin/vault
DEMO_VAULT_ID=

# Channel3 catalog (trychannel3.com)
CHANNEL3_API_KEY=

# OpenAI: agent and speech recognition (platform.openai.com).
# Replies are read aloud by the browser's own voice (speechSynthesis), so there is no TTS service.
OPENAI_API_KEY=
# Cheapest current model with function calling
LLM_MODEL=gpt-6-luna
# Current transcription model; gpt-4o-mini-transcribe is deprecated
STT_MODEL=gpt-transcribe
