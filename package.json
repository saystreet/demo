{
  "name": "saystreet",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel --stream dev",
    "build": "pnpm --recursive build",
    "start": "pnpm --filter @saystreet/backend start",
    "typecheck": "pnpm --recursive typecheck",
    "db:up": "docker compose up -d --wait"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
